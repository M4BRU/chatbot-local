# chatbot-local Environment Configuration
# Copy this file to .env and adjust values as needed

# ===================
# Backend Configuration
# ===================

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Ollama LLM Settings
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB Vector Database
CHROMA_HOST=chromadb
CHROMA_PORT=8100

# Document Storage
DOCUMENTS_PATH=/app/documents

# CORS (comma-separated origins for JSON array)
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# ===================
# Frontend Configuration
# ===================

# API URL for client-side requests
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# Claude API (Agent Orchestrateur mode)
# ===================

# Clé API Anthropic — requise pour le mode Agent (simple_claude / combined)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Modèle Claude à utiliser (défaut: claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6

# ===================
# OpenAI API (modes simple_gpt / combined_gpt)
# ===================

# Clé API OpenAI — requise pour les modes simple_gpt et combined_gpt
OPENAI_API_KEY=sk-...
# Modèle OpenAI à utiliser (défaut: gpt-4o)
# OPENAI_MODEL=gpt-4o

# ===================
# ChromaDB Configuration
# ===================

# Disable telemetry
ANONYMIZED_TELEMETRY=False
ALLOW_RESET=True

# ===================
# Group A — RAG Pipeline Avancé
# ===================

# A3 — Reranker GPU fp16 (~570MB VRAM). Activer uniquement si VRAM suffisante.
# qwen3.5:4b (5.17GB) + reranker fp16 (0.57GB) = 5.74GB (limite RTX 3060 6GB)
# USE_RERANKER_GPU=false

# A2 — Cap diversité sources : max N chunks par document source (0=désactivé)
# Valeur recommandée quand activé : 5
# MAX_CHUNKS_PER_SOURCE=0

# A5 — Multi-query retrieval : génère 2 variantes sémantiques (3 queries total)
# USE_MULTI_QUERY=true

# A6 — HyDE : génère un document hypothétique comme query vectorielle
# USE_HYDE=false

# A4 — MMR : diversification Maximal Marginal Relevance après reranking
# USE_MMR=true
# MMR_LAMBDA=0.6

# A7 — CRAG light : évalue qualité top 2 chunks (2 appels LLM supplémentaires)
# USE_CRAG=false
# CRAG_QUALITY_THRESHOLD=0.5

# A8 — Filtre <think>...</think> dans le stream SSE
# Inutile si ENABLE_NO_THINK=true (le modèle ne génère pas de blocs think)
# FILTER_THINK_FROM_STREAM=false

# ===================
# Group B — Qdrant + bge-m3 + parent/child (migration infra, re-indexation requise)
# ===================

# B1 — Backend vectoriel : "chroma" (défaut) ou "qdrant"
# Démarrer le service qdrant dans docker-compose puis basculer VECTOR_DB=qdrant
# VECTOR_DB=chroma
# QDRANT_HOST=qdrant
# QDRANT_PORT=6333

# B2 — bge-m3 embeddings (dense 1024-dim + sparse SPLADE)
# Prérequis : HF_HUB_OFFLINE=0 au premier démarrage pour télécharger le modèle (~1.1GB)
# puis repasser HF_HUB_OFFLINE=1. USE_HF_EMBEDDINGS=true requis.
# EMBED_HF_MODEL=BAAI/bge-m3-unsupervised  # remplace mixedbread-ai/mxbai-embed-large-v1
# EMBED_SPARSE=false  # true pour activer les vecteurs sparse (Qdrant hybrid search natif)

# B3 — Parent/child chunking (opt-in, nécessite re-indexation complète)
# Child 250 tokens pour l'embedding, parent 1000 tokens pour le contexte LLM
# USE_PARENT_CHILD=false
# CHILD_CHUNK_SIZE_TOKENS=250
# CHILD_CHUNK_OVERLAP_TOKENS=37
# PARENT_CHUNK_SIZE_TOKENS=1000
# PARENT_CHUNK_OVERLAP_TOKENS=100
